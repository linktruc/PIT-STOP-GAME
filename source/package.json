{
  "name": "pit-crew-two-second-challenge",
  "version": "11.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts eslint.config.js --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "preview:local": "npm run build && vite preview --host 0.0.0.0",
    "package": "python3 scripts/package.py",
    "verify:packages": "python3 scripts/verify_packages.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
